{
  "name": "hubtohub",
  "version": "0.2.0",
  "private": true,
  "description": "Seguimiento de paquetes: comprados, en reparto, en locker y enviados.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.js",
    "db:init": "node --env-file-if-exists=.env scripts/init-db.js",
    "db:seed": "node --env-file-if-exists=.env scripts/init-db.js --seed",
    "db:reset": "node --env-file-if-exists=.env scripts/init-db.js --reset --seed",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "pg": "^8.13.0"
  }
}
