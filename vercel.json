{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/paquetes", "destination": "/api/paquetes" },
    { "source": "/paquetes/:id", "destination": "/api/paquetes/:id" },
    { "source": "/config", "destination": "/api/config" },
    { "source": "/eventos", "destination": "/api/eventos" },
    { "source": "/push", "destination": "/api/push" },
    { "source": "/push/prueba", "destination": "/api/push/prueba" }
  ]
}
