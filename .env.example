# Cadena de conexión de Postgres (Supabase: Project Settings -> Database -> Connection string -> pooler).
# Local de pruebas: postgres://usuario:clave@localhost:5432/hubtohub
DATABASE_URL=
APP_ENV=dev

# Notificaciones push (opcional). Genera las claves con: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
